rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /products/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /leads/{id} {
      allow create: if request.resource.data.keys().hasOnly(['productId', 'supplierId', 'name', 'phone', 'quantity', 'message', 'uid', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 100
        && request.resource.data.phone.matches('^[6-9][0-9]{9}$')
        && (request.resource.data.uid == null || request.resource.data.uid == request.auth.uid);
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /requirements/{id} {
      allow create: if request.resource.data.keys().hasOnly(['title', 'category', 'quantity', 'city', 'budget', 'details', 'name', 'phone', 'uid', 'createdAt'])
        && request.resource.data.title is string && request.resource.data.title.size() <= 200
        && request.resource.data.phone.matches('^[6-9][0-9]{9}$')
        && (request.resource.data.uid == null || request.resource.data.uid == request.auth.uid);
      allow read: if request.auth != null;
      allow update, delete: if false;
    }
  }
}
