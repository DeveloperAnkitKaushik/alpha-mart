rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isOwner() {
      return signedIn() && resource.data.uid == request.auth.uid;
    }

    // Staff may only change the workflow fields, and must stamp the write as their own.
    function validStaffUpdate() {
      let d = request.resource.data;
      return isAdmin()
        && d.diff(resource.data).affectedKeys().hasOnly(['status', 'notes', 'updatedAt', 'updatedBy'])
        && d.status in ['new', 'contacted', 'quoted', 'won', 'lost']
        && d.notes is string && d.notes.size() <= 2000
        && d.updatedAt == request.time
        && d.updatedBy == request.auth.uid;
    }

    match /products/{id} {
      allow read: if true;
      allow write: if false;
    }

    // Everything the admin edits under Dashboard → Items, stored as one validated JSON string.
    match /site/content {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['json'])
        && request.resource.data.json is string
        && request.resource.data.json.size() < 1000000;
    }

    // Admin-uploaded images (base64 WebP/JPEG), served by /api/img/{id}. Write-once.
    match /images/{id} {
      allow get: if true;
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['data', 'type', 'by', 'createdAt'])
        && request.resource.data.data is string
        && request.resource.data.data.size() < 1000000
        && request.resource.data.type in ['image/webp', 'image/jpeg']
        && request.resource.data.by == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /leads/{id} {
      allow create: if request.resource.data.keys().hasOnly(['productId', 'supplierId', 'name', 'phone', 'quantity', 'message', 'uid', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 100
        && request.resource.data.phone.matches('^[6-9][0-9]{9}$')
        && (request.resource.data.uid == null || request.resource.data.uid == request.auth.uid);
      allow read: if isAdmin() || isOwner();
      allow update: if validStaffUpdate();
      allow delete: if false;
    }

    match /requirements/{id} {
      allow create: if request.resource.data.keys().hasOnly(['title', 'category', 'quantity', 'city', 'budget', 'details', 'name', 'phone', 'uid', 'createdAt'])
        && request.resource.data.title is string && request.resource.data.title.size() <= 200
        && request.resource.data.phone.matches('^[6-9][0-9]{9}$')
        && (request.resource.data.uid == null || request.resource.data.uid == request.auth.uid);
      allow read: if isAdmin() || isOwner();
      allow update: if validStaffUpdate();
      allow delete: if false;
    }

    match /stock/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /coupons/{id} {
      allow read, write: if false;
    }

    match /orders/{id} {
      allow read: if isAdmin() || isOwner();
      allow write: if false;
    }

    match /carts/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['items'])
        && request.resource.data.items is list && request.resource.data.items.size() <= 30;
    }

    match /favorites/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['productIds'])
        && request.resource.data.productIds is list && request.resource.data.productIds.size() <= 200;
    }

    match /profiles/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['address'])
        && request.resource.data.address is map;
    }
  }
}
